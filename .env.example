# Passkey Auth — Environment Variables
# Copy to .env and fill in values

# Relying party config — MUST match the origin exactly
RP_ID=localhost
RP_ORIGIN=http://localhost:3000
RP_NAME="Passkey Auth Demo"

# PostgreSQL
DATABASE_URL=postgres://passkey:passkey@localhost:5433/passkey_auth

# Server
BIND_ADDRESS=0.0.0.0:3000

# Session TTL in seconds (default: 24 hours)
SESSION_TTL_SECS=86400

# Logging
RUST_LOG=passkey_auth=debug,tower_http=debug
